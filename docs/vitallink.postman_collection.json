                  "pm.test(\"reading 1 is ACCEPTED\", () => pm.expect(results[0].status).to.eql(\"ACCEPTED\"));",
                  "setTimeout(() => {}, 1000);"
                ]
              }
            }
          ]
        },
        {
          "name": "Care plan lowers systolic limit to 140 (RabbitMQ)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rabbitUrl}}/api/exchanges/%2F/careplan.events/publish",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"routing_key\": \"ThresholdsChanged\",\n  \"properties\": {\n    \"content_type\": \"application/json\"\n  },\n  \"payload_encoding\": \"string\",\n  \"payload\": \"{\\\"patientId\\\": \\\"patient-001\\\", \\\"thresholds\\\": [{\\\"metric\\\": \\\"SYSTOLIC\\\", \\\"below\\\": 90, \\\"above\\\": 140}, {\\\"metric\\\": \\\"DIASTOLIC\\\", \\\"below\\\": 50, \\\"above\\\": 110}, {\\\"metric\\\": \\\"PULSE\\\", \\\"below\\\": 40, \\\"above\\\": 130}]}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitUser}}"
                },
                {
                  "key": "password",
                  "value": "{{rabbitPassword}}"
                }
              ]
            },
            "description": "Plays the care-plan system: publishes ThresholdsChanged through RabbitMQ's management API. The service updates its copy in PostgreSQL and deletes the cached limits in Redis."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"routed\", () => pm.expect(pm.response.json().routed).to.be.true);",
                  "setTimeout(() => {}, 2000);"
                ]
              }
            }
          ]
        },
