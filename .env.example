# Copy to .env to override the local defaults. Never commit .env.
# These match the defaults in docker-compose.yml and application.yml.
# They are throwaway credentials for a local Docker database only.
DB_NAME=vitallink
DB_USER=vitallink
DB_PASSWORD=vitallink
DB_URL=jdbc:postgresql://localhost:5432/vitallink
DB_POOL_SIZE=10
RABBITMQ_USER=vitallink
RABBITMQ_PASSWORD=vitallink
REDIS_HOST=localhost
REDIS_PORT=6379
# Needed only to change thresholds through the admin API. Empty means the admin API rejects every request.
# Use a long random value, e.g. from: openssl rand -hex 32
ADMIN_API_KEY=
